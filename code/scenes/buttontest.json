{
  "class": [
    {
      "name": "Node",
      "ref": "app.Drawing.node"
    },
    {
      "name": "RectTriggerBox",
      "ref": "app.TriggerBox.recttriggerbox"
    },
    {
      "name": "NodeSimpleFigure",
      "ref": "code.src.simplefigure"
    },
    {
      "name": "SimpleText",
      "ref": "app.Drawing.TextDrawing.simpletext"
    }
  ],
  "node":[
    {
      "name": "test_button",
      "ref": "Node",
      "dependence": ["Node", "button_rect", "button_trigger"],
      "meta": {
        "background": [0, 0, 0, 0],
        "listeners": {
          "drawing": {
            "show_scene": "update"
          }
        }
      }
    },
    {
      "name": "button_rect",
      "ref": "NodeSimpleFigure",
      "dependence": ["NodeSimpleFigure", "button_text"],
      "meta": {
        "background": "white",
        "pos": [100, 100],
        "size": [100, 100]
      }
    },
    {
      "name": "button_text",
      "ref": "SimpleText",
      "dependence": ["SimpleText"],
      "meta": {
        "pos": [20, 20],
        "size": [100, 80],
        "text": "Press the button",
        "color": [0, 123, 0, 0],
        "font_size": 30,
        "antialias": true
      }
    }
  ],
  "trigger": [
    {
      "name": "button_trigger",
      "ref": "RectTriggerBox",
      "dependence": ["RectTriggerBox"],
      "meta": {
        "size": [100, 100],
        "pos": [100, 100],
        "listeners": {
          "trigger": {
            "lclick": "excecute" 
          }
        }
      }
    }
  ]
}